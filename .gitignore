# Exclude node modules and build artifacts
node_modules/
dist/
build/
.output/
.nuxt/

# Exclude Python environments and caches
venv/
env/
.env
__pycache__/
*.py[cod]
*$py.class

# Exclude data and indexes (Privacy & Performance)
backend/data/
data/
*.db
*.sqlite3

# OS specific files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
.gemini/
.antigravity/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
